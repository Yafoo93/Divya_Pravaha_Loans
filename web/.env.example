# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

# Copy this file to .env and replace CHANGE_ME locally.
# Never commit the real password.

DATABASE_URL="postgresql://divya_pravaha_app:CHANGE_ME@localhost:5432/divya_pravaha_loans?schema=public"
DIRECT_URL="postgresql://divya_pravaha_app:CHANGE_ME@localhost:5432/divya_pravaha_loans?schema=public"

# Bootstrap-only secrets. Use two different values with 12-128 characters.
# Remove these from Vercel after the accounts have been created.
INIT_ADMIN_PASSWORD="CHANGE_ME_TO_A_UNIQUE_12_PLUS_CHARACTER_PASSWORD"
INIT_MANAGER_PASSWORD="CHANGE_ME_TO_ANOTHER_UNIQUE_12_PLUS_CHARACTER_PASSWORD"

# Local Playwright login. Use the real application login for the seeded Manager.
# Do not use the Neon database password and do not commit real credentials.
E2E_MANAGER_EMAIL="manager@example.com"
E2E_MANAGER_PASSWORD="CHANGE_ME_TO_THE_MANAGER_LOGIN_PASSWORD"

  payerReference  String          @db.VarChar(100)
  amountPesewas   Int
  refundedPesewas Int             @default(0)
  createdAt       DateTime        @default(now())
  isSampleData    Boolean         @default(false)
  branchId        String
  receiptId       String?
  originJournalId String          @unique
  branch          Branch          @relation(fields: [branchId], references: [id])
  receipt         Receipt?        @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  originJournal   JournalEntry    @relation("OverpaymentOriginJournal", fields: [originJournalId], references: [id], onDelete: Restrict)
  refundRequests  RefundRequest[]

  @@index([branchId, createdAt])
  @@map("overpayment_liabilities")
}

model RefundRequest {
  id                String               @id @default(cuid())
  requestNumber     String               @unique @db.VarChar(60)
  amountPesewas     Int
  payerVerified     Boolean              @default(false)
  reason            String               @db.VarChar(500)
  status            ControlRequestStatus @default(PENDING)
  requestedAt       DateTime             @default(now())
  decidedAt         DateTime?
  decisionReason    String?              @db.VarChar(500)
  requestedByUserId String
  decidedByUserId   String?
  liabilityId       String
  refundJournalId   String?              @unique
  requestedBy       User                 @relation("RefundRequester", fields: [requestedByUserId], references: [id])
  decidedBy         User?                @relation("RefundChecker", fields: [decidedByUserId], references: [id])
  liability         OverpaymentLiability @relation(fields: [liabilityId], references: [id], onDelete: Restrict)
  refundJournal     JournalEntry?        @relation("RefundJournal", fields: [refundJournalId], references: [id], onDelete: Restrict)

  @@index([liabilityId, status])
  @@map("refund_requests")
}

model JournalLine {
  id            String        @id @default(cuid())
  debitPesewas  Int           @default(0)
  creditPesewas Int           @default(0)
  isSampleData  Boolean       @default(false)
  journalId     String
  accountId     String
  journal       JournalEntry  @relation(fields: [journalId], references: [id], onDelete: Restrict)
  account       LedgerAccount @relation(fields: [accountId], references: [id])
  createdAt     DateTime      @default(now())

  @@index([journalId])
  @@index([accountId])
  @@map("journal_lines")
}

model FundAccount {
  id                 String         @id @default(cuid())
  accountNumber      String         @unique @db.VarChar(50)
  name               String         @db.VarChar(150)
  sourceType         FundSourceType
  eligibleForFunding Boolean        @default(false)
  exclusionReason    String?        @db.VarChar(300)
  isActive           Boolean        @default(true)
  isSampleData       Boolean        @default(false)
  branchId           String
  branch             Branch         @relation(fields: [branchId], references: [id])
  lots               FundLot[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([branchId, eligibleForFunding])
  @@index([sourceType])
  @@map("fund_accounts")
}

model FundLot {
  id                String               @id @default(cuid())
  lotNumber         String               @unique @db.VarChar(50)
  description       String               @db.VarChar(300)
  evidenceReference String               @db.VarChar(120)
  receivedAt        DateTime
  verifiedAt        DateTime?
  originalPesewas   Int
  availablePesewas  Int
  reservedPesewas   Int                  @default(0)
  committedPesewas  Int                  @default(0)
  disbursedPesewas  Int                  @default(0)
  recoveredPesewas  Int                  @default(0)
  status            FundLotStatus        @default(AVAILABLE)
  isSampleData      Boolean              @default(false)
  fundAccountId     String
  fundAccount       FundAccount          @relation(fields: [fundAccountId], references: [id])
  movements         FundMovement[]
  reservations      FundingReservation[]
  allocations       FundAllocation[]
  privateInvestment PrivateInvestment?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([fundAccountId, status])
  @@map("fund_lots")
}

model CapitalContributor {
  id                String                 @id @default(cuid())
  contributorNumber String                 @unique @db.VarChar(40)
  type              CapitalContributorType
  legalName         String                 @db.VarChar(150)
  phone             String?                @db.VarChar(30)
  email             String?                @db.VarChar(254)
  identityReference String?                @db.VarChar(80)
  address           String?                @db.VarChar(300)
  relationshipNote  String?                @db.VarChar(200)
  isActive          Boolean                @default(true)
  branchId          String
  createdByUserId   String
  branch            Branch                 @relation(fields: [branchId], references: [id])
  createdBy         User                   @relation("CapitalContributorCreator", fields: [createdByUserId], references: [id])
  investments       PrivateInvestment[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([branchId, type, isActive])
  @@index([legalName])
  @@map("capital_contributors")
}

model PrivateInvestment {
  id                     String                  @id @default(cuid())
  contractNumber         String                  @unique @db.VarChar(50)
  principalPesewas       Int
  annualReturnBps        Int                     @default(6000)
  dayBasis               Int                     @default(365)
  startDate              DateTime
  maturityDate           DateTime
  clearedAt              DateTime
  evidenceReference      String                  @db.VarChar(120)
  status                 PrivateInvestmentStatus @default(ACTIVE)
  accruedReturnPesewas   Int                     @default(0)
  returnPaidPesewas      Int                     @default(0)
  principalRepaidPesewas Int                     @default(0)
  branchId               String
  contributorId          String
  fundLotId              String                  @unique
  createdByUserId        String
  branch                 Branch                  @relation(fields: [branchId], references: [id])
  contributor            CapitalContributor      @relation(fields: [contributorId], references: [id], onDelete: Restrict)
  fundLot                FundLot                 @relation(fields: [fundLotId], references: [id], onDelete: Restrict)
  createdBy              User                    @relation("PrivateInvestmentCreator", fields: [createdByUserId], references: [id])
  accruals               InvestorReturnAccrual[]
  payouts                InvestorPayout[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([branchId, status, maturityDate])
  @@index([contributorId, status])
  @@map("private_investments")
}

model InvestorReturnAccrual {
  id              String            @id @default(cuid())
  accrualNumber   String            @unique @db.VarChar(60)
  fromDate        DateTime
  throughDate     DateTime
  daysAccrued     Int
  amountPesewas   Int
  sourceReference String            @unique @db.VarChar(80)
  investmentId    String
  investment      PrivateInvestment @relation(fields: [investmentId], references: [id], onDelete: Restrict)
  createdAt       DateTime          @default(now())

  @@unique([investmentId, throughDate])
  @@index([investmentId, throughDate])
  @@map("investor_return_accruals")
}

model InvestorPayout {
  id                     String               @id @default(cuid())
  payoutNumber           String               @unique @db.VarChar(60)
  idempotencyKey         String               @unique @db.VarChar(100)
  type                   InvestorPayoutType
  returnAmountPesewas    Int                  @default(0)
  principalAmountPesewas Int                  @default(0)
  reason                 String               @db.VarChar(500)
  payeeVerified          Boolean              @default(false)
  status                 InvestorPayoutStatus @default(PENDING)
  requestedAt            DateTime             @default(now())
  decidedAt              DateTime?
  paidAt                 DateTime?
  decisionReason         String?              @db.VarChar(500)
  paymentReference       String?              @db.VarChar(100)
  branchId               String
  investmentId           String
  requestedByUserId      String
  decidedByUserId        String?
  branch                 Branch               @relation(fields: [branchId], references: [id])
  investment             PrivateInvestment    @relation(fields: [investmentId], references: [id], onDelete: Restrict)
  requestedBy            User                 @relation("InvestorPayoutRequester", fields: [requestedByUserId], references: [id])
  decidedBy              User?                @relation("InvestorPayoutChecker", fields: [decidedByUserId], references: [id])
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([branchId, status, requestedAt])
  @@index([investmentId, status])
  @@map("investor_payouts")
}

model FundMovement {
  id                     String        @id @default(cuid())
  movementNumber         String        @unique @db.VarChar(60)
  movementType           FundLotStatus
  sourceReference        String        @unique @db.VarChar(100)
  amountPesewas          Int
  principalAmountPesewas Int           @default(0)
  interestAmountPesewas  Int           @default(0)
  notes                  String        @db.VarChar(500)
  occurredAt             DateTime      @default(now())
  isSampleData           Boolean       @default(false)
  fundLotId              String
  actorUserId            String
  fundLot                FundLot       @relation(fields: [fundLotId], references: [id])
  actor                  User          @relation("FundMovementActor", fields: [actorUserId], references: [id])
  createdAt              DateTime      @default(now())

  @@index([fundLotId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("fund_movements")
}

model FundingReservation {
  id                String           @id @default(cuid())
  reservationNumber String           @unique @db.VarChar(60)
  amountPesewas     Int
  status            FundLotStatus    @default(RESERVED)
  reservedAt        DateTime         @default(now())
  committedAt       DateTime?
  cancelledAt       DateTime?
  isSampleData      Boolean          @default(false)
  fundLotId         String
  loanId            String?
  fundLot           FundLot          @relation(fields: [fundLotId], references: [id])
  loan              Loan?            @relation(fields: [loanId], references: [id])
  allocations       FundAllocation[]
  disbursement      Disbursement?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([fundLotId, status])
  @@index([loanId, status])
  @@map("funding_reservations")
}

model FundAllocation {
  id                        String              @id @default(cuid())
  allocationNumber          String              @unique @db.VarChar(60)
  amountPesewas             Int
  recoveredPrincipalPesewas Int                 @default(0)
  recoveredInterestPesewas  Int                 @default(0)
  status                    FundLotStatus       @default(COMMITTED)
  allocatedAt               DateTime            @default(now())
  disbursedAt               DateTime?
  recoveredAt               DateTime?
  isSampleData              Boolean             @default(false)
  fundLotId                 String
  loanId                    String
  reservationId             String?
  fundLot                   FundLot             @relation(fields: [fundLotId], references: [id])
  loan                      Loan                @relation(fields: [loanId], references: [id])
  reservation               FundingReservation? @relation(fields: [reservationId], references: [id])
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  @@index([fundLotId, status])
  @@index([loanId, status])
  @@map("fund_allocations")
}

model Disbursement {
  id                   String             @id @default(cuid())
  disbursementNumber   String             @unique @db.VarChar(60)
  idempotencyKey       String             @unique @db.VarChar(100)
  amountPesewas        Int
  beneficiaryName      String             @db.VarChar(150)
  beneficiaryIdentity  String             @db.VarChar(30)
  identityConfirmed    Boolean            @default(false)
  contractReference    String             @db.VarChar(120)
  managerAuthorization String             @db.VarChar(120)
  actualCashOutAt      DateTime
  status               String             @default("POSTED") @db.VarChar(30)
  isSampleData         Boolean            @default(false)
  loanId               String             @unique
  reservationId        String             @unique
  journalId            String             @unique
  preparedByUserId     String
  authorizedByUserId   String
  loan                 Loan               @relation(fields: [loanId], references: [id])
  reservation          FundingReservation @relation(fields: [reservationId], references: [id])
  journal              JournalEntry       @relation(fields: [journalId], references: [id])
  preparedBy           User               @relation("DisbursementPreparer", fields: [preparedByUserId], references: [id])
  authorizedBy         User               @relation("DisbursementAuthorizer", fields: [authorizedByUserId], references: [id])
  voucher              CashVoucher?
  createdAt            DateTime           @default(now())

  @@index([actualCashOutAt])
  @@map("disbursements")
}

model CashVoucher {
  id                String       @id @default(cuid())
  voucherNumber     String       @unique @db.VarChar(60)
  documentReference String       @db.VarChar(255)
  signedAt          DateTime
  isSampleData      Boolean      @default(false)
  disbursementId    String       @unique
  disbursement      Disbursement @relation(fields: [disbursementId], references: [id])
  createdAt         DateTime     @default(now())

  @@map("cash_vouchers")
}

model RepaymentInstalment {
  id                      String              @id @default(cuid())
  instalmentNumber        Int
  principalPesewas        Int
  interestPesewas         Int
  totalPesewas            Int
  contractualDueDate      DateTime
  effectiveCollectionDate DateTime
  status                  String              @default("AWAITING") @db.VarChar(30)
  principalPaidPesewas    Int                 @default(0)
  interestPaidPesewas     Int                 @default(0)
  loanId                  String
  loan                    Loan                @relation(fields: [loanId], references: [id])
  paymentAllocations      PaymentAllocation[]
  arrear                  Arrear?
  createdAt               DateTime            @default(now())

  @@unique([loanId, instalmentNumber])
  @@index([effectiveCollectionDate, status])
  @@map("repayment_instalments")
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  actorName   String?  @db.VarChar(150)
  actorRole   String?  @db.VarChar(50)
  eventType   String   @db.VarChar(80)
  outcome     String   @db.VarChar(16)
  permission  String?  @db.VarChar(500)
  resource    String?  @db.VarChar(180)
  reason      String?  @db.VarChar(120)
  branchId    String?
  ipAddress   String?  @db.VarChar(64)
  userAgent   String?  @db.VarChar(500)
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([eventType, createdAt])
  @@index([resource, createdAt])
  @@map("audit_events")
}
